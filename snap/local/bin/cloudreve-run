#!/bin/sh
set -eu

umask 077
mkdir -p "$SNAP_COMMON/data"
# --use-working-dir resolves the data folder and stored upload paths from here.
cd "$SNAP_COMMON"

# The default database path ignores --use-working-dir.
export CR_CONF_Database__DBFile="$SNAP_COMMON/data/cloudreve.db"

exec "$SNAP/bin/cloudreve" --use-working-dir --conf "$SNAP_COMMON/data/conf.ini" "$@"
