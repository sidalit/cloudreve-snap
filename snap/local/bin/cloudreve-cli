#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "Run this command with sudo: it works on the service's data in $SNAP_COMMON." >&2
  exit 1
fi
case "${1:-}" in
  '')
    # Upstream starts a server when no command is given.
    set -- --help
    ;;
  server)
    echo "The server runs as a service: sudo snap start|stop|restart cloudreve" >&2
    exit 1
    ;;
esac

exec "$SNAP/bin/cloudreve-run" "$@"
